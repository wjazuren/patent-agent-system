# ===== 大模型配置 =====
# 通义千问示例（国内直连，无需代理）
LLM_API_KEY=your_dashscope_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.6-plus
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.2

# ===== Redis 配置 =====
REDIS_ENABLED=True
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_KEY_PREFIX=patent_agent
REDIS_DEFAULT_TTL_SECONDS=86400
REDIS_PATENT_TTL_SECONDS=604800

# ===== PostgreSQL / pgvector 配置 =====
POSTGRES_DSN=postgresql://postgres:postgres@127.0.0.1:5432/patent_agent
POSTGRES_SCHEMA=patent_agent
VECTOR_DIMENSION=1024
PGVECTOR_HNSW_M=16
PGVECTOR_EF_CONSTRUCTION=64
PGVECTOR_EF_SEARCH=100
EMBEDDING_MODEL_PATH=D:\models\bge-m3
PATENT_SOURCE_SQLITE_PATH=./data/patent_meta.db
PATENT_IMPORT_BATCH_SIZE=500

# ===== 系统配置 =====
MAX_ITERATION_COUNT=3
LOG_LEVEL=INFO
